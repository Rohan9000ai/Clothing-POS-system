# ==============================================
# Muzammil Store POS — Environment Configuration
# Copy this file to .env and fill in real values.
# NEVER commit the real .env file.
# ==============================================

# ---- App ----
APP_NAME="Muzammil Store POS"
APP_ENV=development            # development | production
APP_DEFAULT_LANGUAGE=en        # en | ur

# ---- Database ----
# SQLite file used by Prisma. WAL mode is enabled in the Prisma/SQLite client setup.
DATABASE_URL="file:../../database/muzammil_store.db"

# ---- Auth ----
# Long random string used to sign session/JWT tokens. Generate a new one per install.
AUTH_SECRET="change-this-to-a-long-random-string"
AUTH_TOKEN_EXPIRY="12h"
SESSION_INACTIVITY_TIMEOUT_MIN=30

# ---- Backups ----
BACKUP_DIR="../../database/backups"
BACKUP_KEEP_COUNT=7            # how many recent backups to retain
BACKUP_AUTO_INTERVAL_HOURS=24
# Optional secondary backup location (e.g. a USB drive path or synced cloud folder)
BACKUP_SECONDARY_DIR=""

# ---- Printing ----
THERMAL_PRINTER_NAME=""        # system printer name, set after install
RECEIPT_PAPER_WIDTH_MM=80

# ---- Reports ----
REPORTS_OUTPUT_DIR="../../database/reports"

# ---- Logging ----
LOG_LEVEL=info                 # debug | info | warn | error
LOG_DIR="../../database/logs"
