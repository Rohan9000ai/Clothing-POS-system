{
  "name": "muzammil-store-pos",
  "version": "0.1.0",
  "private": true,
  "description": "Desktop POS system for Muzammil Store (مزمل اسٹور) — Electron + React + TypeScript + SQLite",
  "author": "Muzammil Store",
  "license": "UNLICENSED",
  "workspaces": [
    "apps/desktop",
    "apps/api",
    "apps/web-admin",
    "packages/ui",
    "packages/types",
    "packages/validation",
    "packages/utils",
    "packages/config"
  ],
  "scripts": {
    "dev:desktop": "npm run dev --workspace=apps/desktop",
    "dev:api": "npm run dev --workspace=apps/api",
    "build:desktop": "npm run build --workspace=apps/desktop",
    "build:api": "npm run build --workspace=apps/api",
    "db:migrate": "npm run db:migrate --workspace=apps/api",
    "db:seed": "npm run db:seed --workspace=apps/api",
    "db:backup": "node scripts/backup-database.js",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "eslint": "^9.9.0",
    "prettier": "^3.3.0",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "allowScripts": {
    "@prisma/client@5.22.0": true,
    "@prisma/engines@5.22.0": true,
    "argon2@0.41.1": true,
    "prisma@5.22.0": true,
    "esbuild@0.21.5": true
  }
}
