{
  "name": "@muzammil-pos/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "description": "Electron + React desktop app — Admin dashboard & Cashier POS for Muzammil Store",
  "main": "dist-electron/main/index.js",
  "scripts": {
    "dev": "concurrently -k -n RENDERER,ELECTRON -c blue,magenta \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:renderer": "vite",
    "dev:electron": "wait-on tcp:5173 && npm run build:main && cross-env NODE_ENV=development electron .",
    "build:renderer": "vite build",
    "build:main": "tsc -p tsconfig.main.json",
    "build": "npm run build:renderer && npm run build:main"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0",
    "zustand": "^4.5.5",
    "lucide-react": "^0.446.0",
    "clsx": "^2.1.1",
    "@muzammil-pos/types": "*",
    "@muzammil-pos/validation": "*",
    "@muzammil-pos/utils": "*",
    "@muzammil-pos/ui": "*"
  },
  "devDependencies": {
    "electron": "^32.0.0",
    "vite": "^5.4.0",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5.6.0",
    "tailwindcss": "^3.4.10",
    "postcss": "^8.4.45",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.0.0",
    "wait-on": "^8.0.0",
    "cross-env": "^7.0.3",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@types/node": "^22.0.0"
  }
}